# Copy to .env.local and fill in values for local development.
# Never commit .env.local — it is already covered by .gitignore.

# App runtime connection (Neon in production; local Postgres or a Neon
# branch for development). Must be a restricted, non-superuser role
# subject to Row-Level Security — never a table-owning/superuser role,
# in any environment. See drizzle.config.ts and src/lib/db/tenant-context.ts.
DATABASE_URL=

# Migration connection — a privileged role that can create tables,
# functions, and policies. Used only by drizzle-kit (pnpm db:generate /
# db:migrate / db:studio), never imported by application code. Falls
# back to DATABASE_URL if unset, but production must configure both,
# pointing at two different roles.
MIGRATION_DATABASE_URL=

# Public base URL of the app. Used for building absolute links (emails,
# generated PDFs, OAuth callbacks).
NEXT_PUBLIC_APP_URL=http://localhost:3000
