# Copy to .env.local and fill in values for local development.
# Never commit .env.local — it is already covered by .gitignore.

# Postgres connection string (Neon in production; local Postgres or a
# Neon branch for development). Required once Module 1's schema lands.
DATABASE_URL=

# Public base URL of the app. Used for building absolute links (emails,
# generated PDFs, OAuth callbacks).
NEXT_PUBLIC_APP_URL=http://localhost:3000
